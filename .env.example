# Provider used at startup: Gemini or Cohere (changeable in the UI)
LLM_PROVIDER=Gemini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
COHERE_API_KEY=your_cohere_key_here
COHERE_MODEL=command-a-03-2025
WHISPER_MODEL=tiny

# HackMD live sync (token: https://hackmd.io/settings#api). Leave empty to disable.
HACKMD_API_TOKEN=
# Existing note ID (the id in https://hackmd.io/<id>); or click "Create new note" in the UI
HACKMD_NOTE_ID=
# Read permission for notes created by the app: owner (default), signed_in or guest
HACKMD_READ_PERMISSION=owner
